/**mine.wxss**/
page {
  height: 100vh;
  display: flex;
  flex-direction: column;
  background: #f4f6fa;
}

.scrollarea {
  flex: 1;
  min-height: 0;
  overflow-y: hidden;
}

.content {
  padding: 8rpx 24rpx 60rpx;
  display: flex;
  flex-direction: column;
}

/* 用户区 */
.profile {
  display: flex;
  flex-direction: row;
  align-items: center;
  padding: 36rpx 32rpx;
  border-radius: 28rpx;
  background: linear-gradient(135deg, #2b5cff, #6091ff);
}

.avatar {
  width: 104rpx;
  height: 104rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 52rpx;
  background: rgba(255, 255, 255, 0.24);
}

.avatar__text {
  font-size: 40rpx;
  font-weight: 700;
  color: #ffffff;
}

.profile__info {
  display: flex;
  flex-direction: column;
  margin-left: 24rpx;
}

.profile__name {
  font-size: 36rpx;
  font-weight: 600;
  color: #ffffff;
}

.profile__desc {
  margin-top: 8rpx;
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.86);
}

/* 功能列表 */
.group-title {
  padding: 36rpx 8rpx 16rpx;
  font-size: 26rpx;
  color: #8b98ab;
}

.menu {
  padding: 0 28rpx;
  background: #ffffff;
  border-radius: 28rpx;
}

.menu__item {
  display: flex;
  flex-direction: row;
  align-items: center;
  padding: 28rpx 0;
}

.menu__item--hover {
  opacity: 0.7;
}

.menu__icon {
  width: 76rpx;
  height: 76rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 20rpx;
}

.menu__icon--swap {
  background: #eef2fe;
}

.menu__icon--admin {
  background: #fff6dc;
}

.menu__icon-text {
  font-size: 32rpx;
  font-weight: 600;
  color: #2b5cff;
}

.menu__icon--admin .menu__icon-text {
  color: #b07a00;
}

.menu__body {
  flex: 1;
  display: flex;
  flex-direction: column;
  margin-left: 20rpx;
}

.menu__title {
  font-size: 30rpx;
  font-weight: 500;
  color: #1b2431;
}

.menu__desc {
  margin-top: 6rpx;
  font-size: 22rpx;
  color: #8b98ab;
  line-height: 32rpx;
}

.menu__arrow {
  margin-left: 12rpx;
  font-size: 36rpx;
  color: #c3cbd8;
}

.menu__body--full {
  margin-left: 0;
}

.menu__title--sm {
  font-size: 28rpx;
}

.menu__link {
  padding-left: 16rpx;
  font-size: 24rpx;
  color: #2b5cff;
}

.menu__badge {
  min-width: 34rpx;
  height: 34rpx;
  line-height: 34rpx;
  padding: 0 10rpx;
  margin-left: 12rpx;
  text-align: center;
  font-size: 20rpx;
  color: #ffffff;
  background: #e34d59;
  border-radius: 17rpx;
}

.tip {
  margin-top: 24rpx;
  padding: 18rpx 24rpx;
  background: #fff6dc;
  border-radius: 16rpx;
}

.tip__text {
  font-size: 24rpx;
  color: #8a6a00;
  line-height: 34rpx;
}

.menu__divider {
  height: 1px;
  background: #edf0f5;
}

.footer {
  margin-top: 64rpx;
  text-align: center;
  font-size: 22rpx;
  color: #b3bccb;
}
